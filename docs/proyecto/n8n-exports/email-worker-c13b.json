        "jsCode": "const source = $('C13B - Preparar aviso negocio').item.json;\nconst err = $json ?? {};\n\nconst statusCode = Number(\n  err.statusCode ??\n  err.httpCode ??\n  err.status ??\n  err.details?.httpCode ??\n  err.details?.statusCode ??\n  err.details?.body?.statusCode ??\n  err.response?.statusCode ??\n  err.response?.status ??\n  err.error?.statusCode ??\n  err.error?.httpCode ??\n  0\n);\n\nconst rawMessage =\n  err.details?.description ??\n  err.details?.body?.message ??\n  err.error?.message ??\n  err.message ??\n  (typeof err.error === 'string' ? err.error : '') ??\n  'Error desconocido al enviar el aviso al negocio mediante Resend';\n\nconst safeError = String(rawMessage)\n  .replace(/Bearer\\s+[A-Za-z0-9._-]+/gi, 'Bearer [REDACTED]')\n  .replace(/re_[A-Za-z0-9_-]+/gi, 're_[REDACTED]')\n  .slice(0, 500);\n\nconst networkError =\n  statusCode === 0 &&\n  /timeout|timed out|econnreset|econnrefused|enotfound|network|socket|fetch failed/i.test(safeError);\n\nconst temporaryHttpError =\n  statusCode === 408 ||\n  statusCode === 425 ||\n  statusCode === 429 ||\n  statusCode >= 500;\n\nconst attemptCount = Math.max(1, Number(source.attempt_count ?? 1));\n\nconst retryable =\n  attemptCount < 5 &&\n  (networkError || temporaryHttpError);\n\nconst retryMinutesByAttempt = {\n  1: 2,\n  2: 10,\n  3: 30,\n  4: 60,\n};\n\nconst retryMinutes =\n  retryable\n    ? (retryMinutesByAttempt[attemptCount] ?? 60)\n    : null;\n\nreturn {\n  json: {\n    job_id: source.job_id,\n    claim_token: source.claim_token,\n    delivery_id: source.delivery_id,\n    attempt_count: attemptCount,\n    c13_error_source: 'resend',\n    c13_error_branch: 'business_notification',\n    c13_error_status_code: statusCode || null,\n    c13_error_message: safeError,\n    c13_error_retryable: retryable,\n    retry_at: retryable\n      ? new Date(Date.now() + retryMinutes * 60 * 1000).toISOString()\n      : null,\n  },\n};"
