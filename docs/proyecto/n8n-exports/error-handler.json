      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const current = $('Registrar alerta operativa DEV').first().json;\nconst matching = $input.all().map(item => item.json).filter(row => row.id !== undefined);\nconst currentId = Number(current.id);\nif (!Number.isFinite(currentId) || !matching.some(row => Number(row.id) === currentId)) return [];\nif (matching.some(row => Number(row.id) !== currentId && new Date(row.timestamp).getTime() <= new Date(current.timestamp).getTime())) return [];\nconst executionId = String(current.execution_id || '');\nconst executionUrl = /^\\d+$/.test(executionId) && current.workflow === 'SolicitudPro DEV - Email Worker C13B'\n  ? `https://n8n.example.invalid/workflow/PUBLIC_SOLICITUDPRO_DEV_EMAIL_WORKER_C13B_WORKFLOW_ID/executions/${executionId}` : '';\nreturn [{json: {workflow: current.workflow, execution_id: executionId, node: current.node, timestamp: current.timestamp, message: current.message, execution_url: executionUrl}}];"
      }
    }
