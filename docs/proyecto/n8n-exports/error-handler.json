    {
      "parameters": {
        "jsCode": "function sanitize(value) {\n  return String(value || 'Error no especificado')\n    .replace(/[\\u0000-\\u001f\\u007f]+/g, ' ')\n    .replace(/\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b/gi, '[email]')\n    .replace(/\\bAuthorization\\s*[:=]\\s*(?:Bearer\\s+)?[^\\s,;]+/gi, 'Authorization=[redacted]')\n    .replace(/\\bBearer\\s+[A-Za-z0-9._~+/=-]+/gi, 'Bearer [redacted]')\n    .replace(/\\b[a-z_]*(?:role|key|token|password|secret|credential)[a-z_]*\\s*[:=]\\s*[^\\s,;]+/gi, '[redacted]')\n    .replace(/\\bsb_[a-z]+_[A-Za-z0-9_-]+/gi, '[redacted]')\n    .replace(/\\bre_[A-Za-z0-9_-]+/gi, 're_[redacted]')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .slice(0, 500);\n}\n\nreturn $input.all().map((item) => ({\n  json: {\n    occurred_at: new Date().toISOString(),\n    workflow_name: sanitize(item.json.workflow?.name || 'No especificado'),\n    failed_node: sanitize(\n      item.json.execution?.lastNodeExecuted ||\n      item.json.trigger?.error?.node?.name ||\n      'No especificado'\n    ),\n    execution_id: sanitize(item.json.execution?.id || 'No especificado'),\n    error_message: sanitize(\n      item.json.execution?.error?.message ||\n      item.json.trigger?.error?.message ||\n      item.json.trigger?.error?.cause?.message\n    ),\n    handling_status: 'pending_output_configuration',\n  },\n}));"
      },
