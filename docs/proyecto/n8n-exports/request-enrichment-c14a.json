    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $('C14A - Separar solicitudes reclamadas').item.json;\nlet candidate = $json ?? {};\nconst raw = candidate.output_text ?? candidate.output ?? candidate.text ?? candidate.content ?? candidate.response;\nif ((!candidate.internal_summary || !candidate.suggested_reply) && typeof raw === 'string') {\n  try { candidate = JSON.parse(raw); } catch { candidate = {}; }\n} else if ((!candidate.internal_summary || !candidate.suggested_reply) && raw && typeof raw === 'object' && !Array.isArray(raw)) {\n  candidate = raw;\n}\nconst normalize = (value) => typeof value === 'string' ? value.replace(/[\\u0000-\\u001f\\u007f]+/g, ' ').replace(/\\s+/g, ' ').trim() : '';\nconst internalSummary = normalize(candidate.internal_summary);\nconst suggestedReply = normalize(candidate.suggested_reply);\nconst forbidden = /<\\/?[a-z][^>]*>|system\\s+prompt|developer\\s+message|api[_ -]?key|service[_ -]?role|authorization\\s*[:=]|bearer\\s+|stack\\s+trace|traceback|sb_secret_|\\bsk-[a-z0-9]/i;\nconst valid = internalSummary.length >= 20 && internalSummary.length <= 600 && suggestedReply.length >= 40 && suggestedReply.length <= 1200 && !forbidden.test(internalSummary) && !forbidden.test(suggestedReply);\nreturn { json: { business_id: job.business_id, request_id: job.request_id, claim_token: job.claim_token, valid, internal_summary: valid ? internalSummary : null, suggested_reply: valid ? suggestedReply : null } };"
