    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const job = $('C14A - Separar solicitudes reclamadas').item.json;\nconst err = $json ?? {};\nconst status = Number(err.statusCode ?? err.httpCode ?? err.status ?? err.response?.status ?? err.error?.statusCode ?? 0);\nconst message = String(err.message ?? err.error?.message ?? err.details?.description ?? 'gateway_error').slice(0, 300);\nlet errorCode = 'configuration';\nif (status === 408 || /timeout|timed out/i.test(message)) errorCode = 'timeout';\nelse if (status === 429) errorCode = 'rate_limited';\nelse if (status >= 500) errorCode = 'gateway_5xx';\nelse if (status === 0 && /network|econn|enotfound|socket|fetch failed/i.test(message)) errorCode = 'network';\nconst transient = ['timeout', 'rate_limited', 'gateway_5xx', 'network'].includes(errorCode);\nconst attempt = Math.max(1, Number(job.attempt_count ?? 1));\nconst retryMinutes = { 1: 2, 2: 10, 3: 30, 4: 60 }[attempt] ?? null;\nconst retryAt = transient && attempt < 5 && retryMinutes ? new Date(Date.now() + retryMinutes * 60000).toISOString() : null;\nreturn { json: { business_id: job.business_id, request_id: job.request_id, claim_token: job.claim_token, error_code: errorCode, retry_at: retryAt } };"
      },
